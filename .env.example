NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never prefix with NEXT_PUBLIC_. Used by src/lib/openai/client.ts
# for M5.2 soft-ranking (src/lib/matching/soft-rank.ts).
OPENAI_API_KEY=
# Optional, defaults to gpt-4o-mini if unset.
OPENAI_MODEL=

# ── Transactional email (booking lifecycle; see src/lib/email/config.ts) ──
# Server-only — never prefix with NEXT_PUBLIC_.
# Supabase SECRET key (service_role). Used ONLY by the email sender and the Stripe payment
# server code (src/lib/supabase/admin.ts): outbox/recipients, and 0037's service_role functions.
SUPABASE_SECRET_KEY=
# off (default: nothing happens) | log (render + log, never send) | send
EMAIL_DELIVERY_MODE=off
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. Felyn <bookings@felyn.eu>
EMAIL_FROM=
# Optional plain address for replies, e.g. hello@felyn.eu
EMAIL_REPLY_TO=
# Base for email links; required for send, https only. Production: https://app.felyn.eu
EMAIL_APP_URL=
# Optional, comma-separated. When set, only these addresses receive email.
EMAIL_RECIPIENT_ALLOWLIST=
# Bearer secret for POST /api/email/sweep (at least 32 characters). Unset = route disabled.
# Production: the same value as the Supabase Vault secret email_sweep_secret, used by
# the pg_cron job (supabase/migrations/email_outbox_sweep_schedule.sql). Use only
# A-Z a-z 0-9 _ - (e.g. openssl rand -hex 32). Never commit a real value.
EMAIL_SWEEP_SECRET=

# ── Stripe payments: TEST MODE ONLY (see src/lib/payments/config.ts and
#    docs/payments/stripe-test-mode-runbook.md). Server-only — never NEXT_PUBLIC_.
# false (default) = no payment is offered and the webhook routes answer 404.
PAYMENTS_ENABLED=false
# test only: "live" and live keys (sk_live_/rk_live_) are refused by this build.
STRIPE_MODE=test
# rk_test_... (restricted, preferred) or sk_test_...
STRIPE_SECRET_KEY=
# whsec_... of the platform endpoint /api/stripe/webhook (same value in the database:
# felyn_private.stripe_webhook_secrets, 'platform')
STRIPE_WEBHOOK_SECRET=
# whsec_... of the Connect endpoint /api/stripe/connect-webhook ('connect' in the database)
STRIPE_CONNECT_WEBHOOK_SECRET=
# Origin for Stripe return links, e.g. http://localhost:3000 or https://app.felyn.eu
PAYMENTS_APP_URL=
